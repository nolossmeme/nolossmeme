# apps/web and apps/landing (optional overrides; defaults point at testnet)
VITE_NEAR_NETWORK=testnet
VITE_FACTORY_ID=factory.nolossmeme.testnet
# where each site finds the other (defaults: landing http://localhost:5174/, app http://localhost:5173/)
VITE_APP_URL=http://localhost:5173/
VITE_LANDING_URL=http://localhost:5174/

# optional backend (services/backend) the web app reads activity and time series from
VITE_INDEXER_URL=http://localhost:8787
# Cloudflare Turnstile site key: enables the "Need testnet NEAR?" faucet card (backend needs the secret)
VITE_TURNSTILE_SITE_KEY=

# tools/keeper
NEAR_NETWORK=testnet
KEEPER_ACCOUNT_ID=keeper.nolossmeme.testnet
KEEPER_PRIVATE_KEY=ed25519:...
DRY_RUN=1
