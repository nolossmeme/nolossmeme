{
  "name": "@nolossmeme/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Indexer, REST API and scheduled jobs for NoLossMeme",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "backfill": "tsx src/cli/backfill.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@libsql/client": "^0.18.0",
    "@nolossmeme/sdk": "workspace:*",
    "hono": "^4.13.16",
    "near-api-js": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  }
}
